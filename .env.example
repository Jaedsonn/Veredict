# Lido pelo docker compose, pelo pydantic (make dev/migrate) e pelo Makefile, que só
# extrai as senhas sem executar o arquivo. Formato KEY=valor em uma linha, sem espaço
# em volta do "=", sem `export` e sem comentário na mesma linha do valor; valores com
# espaço vão entre aspas
# Senhas: @ % / : são aceitos (escapados na URL do banco); ' e \ não (viram literal SQL
# no docker/mysql/init); $ também não (o compose e o pydantic tratam como variável)

# MySQL: root só para o initdb; migrator faz o DDL; um usuário de runtime por serviço
MYSQL_ROOT_PASSWORD=change-me-root
DB_MIGRATOR_PASSWORD=change-me-migrator
AUTH_DB_PASSWORD=change-me-auth
NOTIFICATION_DB_PASSWORD=change-me-notification
LOGS_DB_PASSWORD=change-me-logs

# Dev fora do Docker (make dev/migrate) e porta do MySQL publicada no host
DB_HOST=localhost
DB_PORT=3307

# Serviços internos no make dev; no compose são http://monitoring:8000 e http://notification:8000
MONITORING_URL=http://localhost:8003
NOTIFICATION_URL=http://localhost:8002

# Token das chamadas entre serviços internos: mínimo de 16 caracteres; gere com
# `openssl rand -hex 32`
INTERNAL_API_TOKEN=change-me-internal-token

# Nível dos logs JSON de todos os serviços: DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO

# Gerados no #9 com `make keys`, em uma linha só
