# Pepper do HMAC-SHA256 dos códigos de verificação (#8, ADR-007); mínimo de 16 caracteres
VERIFICATION_PEPPER=change-me-verification-pepper

# E-mail do notification fora do Docker (make dev s=notification): o SMTP do Mailpit
# publicado no host; no compose ele usa sempre mailpit:1025 (UI em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Veriditi <no-reply@veriditi.app>"
SMTP_STARTTLS=false

# Links nos e-mails apontam para a web
WEB_URL=http://localhost:3000

# Web fora do Docker (npm run dev:web); no compose a web usa http://gateway:8000
GATEWAY_URL=http://localhost:8080

# Portas publicadas no host
WEB_PORT=3000
GATEWAY_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
